
Функция ПолЗначениеСБИС(Значение1С)
	Результат = Неопределено;
	Если Значение1С = "М" Тогда
		Результат = "M"
	Иначе
		Если Значение1С = "Ж" Тогда
			Результат = "F";
		КонецЕсли;
	КонецЕсли;
	Возврат Результат;
КонецФункции

Функция ПолЗначение1С(ЗначениеСБИС)
	Результат = Неопределено;
	Если ЗначениеСБИС = "M" Тогда
		Результат = "М"
	Иначе
		Если ЗначениеСБИС = "F" Тогда
			Результат = "Ж";
		КонецЕсли;
	КонецЕсли;
	Возврат Результат;
КонецФункции

