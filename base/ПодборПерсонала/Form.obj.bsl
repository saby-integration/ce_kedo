	СтандартнаяОбработка = Ложь;
	СписокОбработкаВыбораСтроки();
КонецПроцедуры

&НаКлиенте
Процедура СписокКандидатовПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	Отказ = Истина;
КонецПроцедуры

&НаКлиенте
Процедура СписокКандидатовПередУдалением(Элемент, Отказ)
	Отказ = Истина;
КонецПроцедуры

&НаКлиенте
Процедура СписокКомандаОткрыть(Команда)
	ТекущиеДанные = Элементы.СписокКандидатов.ТекущиеДанные;
	Если ЗначениеЗаполнено(ТекущиеДанные.Документ1С) Тогда 
		ПоказатьЗначение(, ТекущиеДанные.Документ1С);
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура СписокОбработкаВыбораСтроки()
	
	ТекущиеДанные = Элементы.СписокКандидатов.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекущиеДанные.Телефон = "Загрузить ещё" Тогда
		ТекущаяСтраница = ТекущаяСтраница + 1;
		СписокКандидатов.Удалить(ТекущиеДанные);
		ОбновитьСписок(Ложь);
		Возврат;
	Иначе
		Если Не ТекущиеДанные.Объект1С = Неопределено Тогда
			ПоказатьЗначение(, ТекущиеДанные.Объект1С);
			Возврат;
		Иначе
			ПоказатьОповещениеПользователя(
				"",,"Физическое лицо отсутствует в 1С"
				,КартинкаОшибка());
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция СформироватьМассивОбрабатываемыхКандидатов()  
	ВыгружаемыеДокументы = Новый Массив();
	Для Каждого ВыгружаемыйДокумент Из Элементы.СписокКандидатов.ВыделенныеСтроки Цикл
		СтрокаСпискаКандидатов = СписокКандидатов.НайтиПоИдентификатору(ВыгружаемыйДокумент);
		Если СтрокаСпискаКандидатов.Телефон = "Загрузить ещё" Тогда
			Продолжить;
		КонецЕсли;
				
		API3_ref = Новый Структура; 
		API3_ref.Вставить("SbisId",		СтрокаСпискаКандидатов.Идентификатор);
		API3_ref.Вставить("SbisType",	"Кандидат");
		API3_ref.Вставить("Type",		"Кандидат");
		API3_ref.Вставить("Title",		СтрокаСпискаКандидатов.ФИО);
		ВыгружаемыеДокументы.Добавить(API3_ref);
	КонецЦикла;
	Возврат ВыгружаемыеДокументы; 	
КонецФункции

&НаКлиенте
Процедура ВыгрузитьВ1С(Команда)
	context_params	= ПроверитьНаличиеПараметровПодключенияНаСервере();
	ВыгружаемыеДокументы = СформироватьМассивОбрабатываемыхКандидатов();
	
	Контекст = Новый Структура;
	Контекст.Вставить("algorithm", "Документы_update");
	EndpointArgs = Новый Структура;
	EndpointArgs.Вставить("list_doc_ref", ВыгружаемыеДокументы);
	ПараметрыВызова = Новый Структура;
	ПараметрыВызова.Вставить("EndpointArgs", EndpointArgs);	
	Контекст.Вставить("ПараметрыВызова", ПараметрыВызова);
	Контекст.Вставить("context_params", context_params);
	Контекст.Вставить("НазваниеОперации", "Выгрузка в 1С");
	BlocklyExecutor.ЗапуститьINI(Контекст);
КонецПроцедуры

&НаКлиенте
Функция ТекущийОбъектИС() 
	ТД = Элементы.СписокКандидатов.ТекущиеДанные;
	Если ТД = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат ТД.Объект1С;
КонецФункции

&НаСервере
Функция СтруктураВыгрузкиДокумента(Знач Документ1С)
	Возврат Новый Структура("Ссылка,UID,ТипМетаданных,ТипОбъекта,ИмяИни", 
							Документ1С.Ссылка,
							Неопределено,
							Документ1С.Ссылка.Метаданные().Имя,
							Неопределено,
							Неопределено); 	
КонецФункции	

&НаКлиенте
Процедура ОбновитьВСБИС(Команда)
	Документ1С = ТекущийОбъектИС();
	Если Не ЗначениеЗаполнено(Документ1С) Тогда 
		ПоказатьОповещениеПользователя(
			"Ошибка",,
			"Невозможно обновить объект " + Врег(ИмяПродукта()) + ", так как он не был выгружен в 1С",
			БиблиотекаКартинок["Ошибка32"]);
		Возврат; 
	КонецЕсли;
	
	ДокументПереотправить = Новый Массив();
	ДокументПереотправить.Добавить(СтруктураВыгрузкиДокумента(Документ1С));
	ПараметрыВФорму = Новый Структура("Источник", ДокументПереотправить);
	ОткрытьФормуОбработки("ЗагрузкаДокументов", ПараметрыВФорму, ЭтаФорма, Новый УникальныйИдентификатор());
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьВСБИС(Команда)
	ТД = Элементы.СписокКандидатов.ТекущиеДанные;
	Если ТД <> Неопределено И ЗначениеЗаполнено(ТД.СсылкаСБИС) Тогда
		ЗадачаСсылка = ПолучитьПрямуюССылку(ТД.СсылкаСБИС);
		#Если ТолстыйКлиентОбычноеПриложение Тогда
		// BSLLS:UsingSynchronousCalls-off
		ЗапуститьПриложение(ЗадачаСсылка);
		// BSLLS:UsingSynchronousCalls-on
		#Иначе	
		ПерейтиПоНавигационнойСсылке(ЗадачаСсылка);	
		#КонецЕсли
	КонецЕсли;	
КонецПроцедуры

