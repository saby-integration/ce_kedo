
// BSLLS:UnusedLocalVariable-off Переменные формы
&НаКлиенте
Перем ТранспортИнтеграции, BlocklyExecutor;
// BSLLS:UnusedLocalVariable-on

#Область include_kedo_base_ЭДО_Form_ПодборПерсонала_УстановитьЛокализацию
#КонецОбласти

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ЭтаФорма.ТипПоиска = "Отсутствует";
	ДобавитьИнформациюОВерсии(Элементы.ВерсияПродукта);
	ЭтаФорма.ЭтоВнешняяОбработка = ЭтоВнешняяОбработка();
	УстановитьЛокализацию();
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	context_params = ПроверитьНаличиеПараметровПодключенияНаСервере(); 
	Если context_params = Неопределено Тогда 
		ПоказатьОповещениеПользователя("Ошибка", ,
			"Необходима авторизация", ,
			СтатусОповещенияПользователя.Информация,
			Новый УникальныйИдентификатор);
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	ТранспортИнтеграции = ПолучитьФормуТранспорта(context_params);
	BlocklyExecutor = ПолучитьФормуBlockly();

	СтатусВерсии = ПолучитьИнформациюОВерсииПоУмолчанию();
	СтатусВерсии = ПолучитьСтатусВерсииНаФорме(Ложь);
	ОбновитьИнформациюОВерсии(СтатусВерсии);

	ОбновитьСписок();	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	Если ИмяСобытия = "SabySignOut" Тогда
		Закрыть();
	ИначеЕсли ИмяСобытия = "Saby_ЗавершениеДлительнойОперации" Или ИмяСобытия = "Saby_ЗавершениеВыполнитьДействие" Тогда
		ОбновитьСписок();
	Иначе
		Возврат;
	КонецЕсли;
	
	// TODO Переписать на обновление только выделенных строк.
КонецПроцедуры

