
	КоманднаяПанель  = Неопределено;
	РодительЭлемента	= Неопределено;
	Если ПараметрыРазмещения.Свойство("КоманднаяПанель",  КоманднаяПанель) Тогда
		Если КоманднаяПанель = Неопределено Тогда
			Возврат;
		КонецЕсли;
		РодительЭлемента	= Форма.Элементы.Найти(КоманднаяПанель.Имя);
	КонецЕсли;
	Если	РодительЭлемента = Неопределено	Тогда
		Возврат;
	КонецЕсли;
	ДочерниеЭлементы	= РодительЭлемента.ПодчиненныеЭлементы;
	
	// Сдвигаем кнопку на форме журнала докуимента Отпуска
	Если Найти(Форма.ИмяФормы, "ЖурналДокументов.Отпуска.Форма.ФормаСписка") > 0 Тогда
		Подгруппа		= Форма.Элементы.Найти("ИнтеграцияГруппаКоманд");
		СтрокаПоиска	= ДочерниеЭлементы.Найти("ПодменюРассылкаДокументов");
		Если	СтрокаПоиска <> Неопределено
				И Подгруппа <> Неопределено	Тогда
			Форма.Элементы.Переместить(Подгруппа, РодительЭлемента, СтрокаПоиска);
		КонецЕсли;
	КонецЕсли;
