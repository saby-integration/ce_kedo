// Уход от версионирования, Метод ВывестиКоманды Выхывается всего 1 раз из ПриСозданииНаСервере, у которого
// меняются параметры и мы зависм от версии БСП

&НаСервере
&Вместо("ВывестиКоманды")
Процедура Integration_ВывестиКоманды(Форма, Команды, ПараметрыРазмещения)
	ПродолжитьВызов(Форма, Команды, ПараметрыРазмещения);
	
	// Вставить содержимое метода.
	МодульВстраиваниеВСтандартныеФормы = МодульВстраиваниеВСтандартныеФормы(); 
	КомандыТаблица = ТаблицаКоманд(); // Получаем пустую таблицу команд средствами 1с
	МодульВстраиваниеВСтандартныеФормы.ВстроитьЭлементыИнтеграцииНаФорму(Форма, ПараметрыРазмещения, КомандыТаблица);

#Область include_kedo_base_CommonModule_ПодключаемыеКоманды_ВывестиКомандыКонфигурация
#КонецОбласти

КонецПроцедуры
