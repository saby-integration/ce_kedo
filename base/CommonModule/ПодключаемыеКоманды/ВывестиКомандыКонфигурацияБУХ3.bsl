
	// Сдвинем в лево группу команд Saby
	КПанель  = Неопределено;
	РодительЭлемента	= Неопределено;
	Если ПараметрыРазмещения.Свойство("КоманднаяПанель",  КПанель) Тогда
		Если КПанель = Неопределено Тогда
			Возврат;
		КонецЕсли;
		РодительЭлемента	= Форма.Элементы.Найти(КПанель.Имя);
	КонецЕсли;
	ДочерниеЭлементы	= РодительЭлемента.ПодчиненныеЭлементы;
	
	Подгруппа			= ДочерниеЭлементы.Найти("ИнтеграцияГруппаКоманд");
	СтрокаПоиска		= ДочерниеЭлементы.Найти("СтрокаПоиска");
	Если
		РодительЭлемента <> Неопределено
		И СтрокаПоиска <> Неопределено
		И Подгруппа <> Неопределено
									Тогда
		Форма.Элементы.Переместить(Подгруппа, РодительЭлемента, СтрокаПоиска);
	КонецЕсли;
